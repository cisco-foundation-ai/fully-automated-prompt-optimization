{
  "tenant_id": "livebench_math",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-4.1-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/livebench_math/datasets/datasets/val_olympiad.jsonl"
  },
  "chain": {
    "path": "tenants/livebench_math/chains/solve_best_of_n.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "olympiad": "tenants/livebench_math/prompts/variants/variant-026-olympiad.md",
        "default": "tenants/livebench_math/prompts/variants/variant-026-olympiad.md"
      },
      "samples_per_task": {
        "olympiad": 11,
        "default": 11
      }
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/livebench_math/code/scorers/livebench_math_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/livebench_math/evals/tmp/olympiad-bestofn-v026"
}
