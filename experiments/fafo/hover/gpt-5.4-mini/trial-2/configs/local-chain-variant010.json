{
  "tenant_id": "hover",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-5.4-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/hover/datasets/datasets/val.jsonl"
  },
  "chain": {
    "path": "tenants/hover/chains/multi_hop_4_dedup_title_rescue_v5.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "summarize1": "tenants/hover/prompts/modules/summarize1/variant-002.md",
        "query_hop2": "tenants/hover/prompts/modules/query_hop2/variant-005.md",
        "summarize2": "tenants/hover/prompts/modules/summarize2/variant-002.md",
        "query_hop3": "tenants/hover/prompts/modules/query_hop3/variant-005.md",
        "summarize3": "tenants/hover/prompts/modules/summarize3/variant-002.md",
        "query_hop4": "tenants/hover/prompts/modules/query_hop4/variant-005.md",
        "rescue_query": "tenants/hover/prompts/modules/rescue_query/variant-009.md"
      },
      "retrieval_k_hop1": 25,
      "retrieval_k_hop2": 22,
      "retrieval_k_hop3": 22,
      "retrieval_k_hop4": 22,
      "retrieval_k_rescue": 20,
      "oversample": 8,
      "augment_with_claim": false,
      "bm25_data_dir": "tenants/hover/data/bm25"
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/hover/code/scorers/hover_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/hover/evals/tmp/chain-v5-rescue009-os8-val",
  "max_workers": 5
}
