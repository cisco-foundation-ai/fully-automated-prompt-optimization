{
  "tenant_id": "hover",
  "provider": "litellm",
  "provider_settings": {
    "model": "bedrock/google.gemma-3-12b-it",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 0.9,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/hover/datasets/datasets/val.jsonl"
  },
  "chain": {
    "path": "tenants/hover/chains/multi_hop.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "summarize1": "tenants/hover/prompts/modules/summarize1/variant-013.md",
        "query_hop2": "tenants/hover/prompts/modules/query_hop2/variant-006.md",
        "summarize2": "tenants/hover/prompts/modules/summarize2/variant-017.md",
        "query_hop3": "tenants/hover/prompts/modules/query_hop3/variant-017.md",
        "summarize3": "tenants/hover/prompts/modules/summarize3/variant-017.md",
        "query_hop4": "tenants/hover/prompts/modules/query_hop4/variant-017.md"
      },
      "retrieval_k": 75,
      "bm25_data_dir": "tenants/hover/data/bm25"
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/hover/code/scorers/hover_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/hover/evals/tmp/chain-variant019-t09-val",
  "max_workers": 5
}
