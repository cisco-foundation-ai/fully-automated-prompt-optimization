      },
      "untrusted_model": {
        "provider": "openai",
        "model": "gpt-5.4-mini",
        "temperature": 0.7,
        "max_tokens": 4096
      }
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/papillon/code/scorers/papillon_scorer.py",
      "class_name": "Scorer"
