  "provider_settings": {
    "model": "gpt-5.4-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 0.7,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/papillon/datasets/datasets/test.jsonl"
  },
  "chain": {
    "path": "tenants/papillon/chains/privacy_chain.py",
    "fn": "build_chain",
