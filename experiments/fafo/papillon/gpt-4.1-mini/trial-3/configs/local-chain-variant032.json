{
  "tenant_id": "papillon",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-4.1-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/papillon/datasets/datasets/val.jsonl"
  },
  "chain": {
    "path": "tenants/papillon/chains/privacy_chain_v2.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "redact_query": "tenants/papillon/prompts/modules/redact_query/variant-006.md",
        "reconstruct_response": "tenants/papillon/prompts/modules/reconstruct_response/variant-003.md"
      },
      "trusted_model": {
        "provider": "openai",
        "model": "gpt-4.1-mini",
        "max_tokens": 16000,
        "top_p": 0.95
      },
      "step_temperatures": {
        "redact_query": 1.0,
        "reconstruct_response": 0.9
      },
      "untrusted_model": {
        "provider": "openai",
        "model": "gpt-4.1-mini",
        "temperature": 1.0,
        "max_tokens": 4096
      }
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/papillon/code/scorers/papillon_scorer.py",
      "class_name": "Scorer"
    },
    "tenant_config": {
      "judge_model": "gpt-4.1-mini",
      "judge_provider": "openai"
    }
  },
  "output_dir": "tenants/papillon/evals/tmp/chain-variant032"
}
