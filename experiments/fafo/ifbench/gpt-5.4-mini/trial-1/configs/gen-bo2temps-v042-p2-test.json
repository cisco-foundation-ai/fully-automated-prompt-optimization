{
  "tenant_id": "ifbench",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-5.4-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 0.0,
    "top_p": 1.0,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/ifbench/datasets/datasets/test.jsonl"
  },
  "chain": {
    "path": "tenants/ifbench/chains/generate_best_of_2_temps.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "generate": "tenants/ifbench/prompts/modules/generate/variant-042.md",
        "picker": "tenants/ifbench/prompts/modules/picker/variant-002.md"
      },
      "temp_b": 0.7
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/ifbench/code/scorers/ifbench_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/ifbench/evals/tmp/gen-bo2temps-v042-p2-test",
  "max_workers": 5
}
