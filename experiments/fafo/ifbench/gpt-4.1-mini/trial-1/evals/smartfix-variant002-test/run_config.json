{
  "run_id": "hephaestus-ifbench-tfktr0",
  "tenant_id": "ifbench",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-4.1-mini",
    "timeout_seconds": 600,
    "max_retries": 3,
    "retry_backoff_seconds": 10,
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset_path": "tenants/ifbench/datasets/datasets/test.jsonl",
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/ifbench/code/scorers/ifbench_scorer.py",
      "class_name": "Scorer"
    }
  },
  "max_workers": 2,
  "chain": {
    "path": "tenants/ifbench/chains/generate_verify_smartfix.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "generate": "tenants/ifbench/prompts/modules/generate/variant-002.md",
        "verify": "tenants/ifbench/prompts/modules/verify/variant-002.md"
      }
    }
  }
}