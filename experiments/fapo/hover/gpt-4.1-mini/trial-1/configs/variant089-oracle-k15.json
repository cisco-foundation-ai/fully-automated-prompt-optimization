{
  "tenant_id": "hover",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-4.1-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/hover/datasets/datasets/val-quick75.jsonl"
  },
  "chain": {
    "path": "tenants/hover/chains/multi_hop.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "summarize1": "tenants/hover/prompts/modules/summarize1/variant-003.md",
        "query_hop2": "tenants/hover/prompts/modules/query_hop2/variant-001.md",
        "summarize2": "tenants/hover/prompts/modules/summarize2/variant-003.md",
        "query_hop3": "tenants/hover/prompts/modules/query_hop3/variant-001.md",
        "title_oracle": "tenants/hover/prompts/modules/title_oracle/variant-002.md"
      },
      "retrieval_k": 25,
      "retrieval_k_hop3": 25,
      "dedup_retrieval": true,
      "multi_segment_hop1": true,
      "segment_extra_k": 10,
      "entity_augmented": true,
      "entity_k_hop2": 15,
      "entity_k_hop3": 15,
      "claim_entity_k": 8,
      "entity_fetch_k": 3,
      "passage_mining": true,
      "mining_k": 20,
      "title_oracle": true,
      "oracle_k": 15,
      "bm25_data_dir": "tenants/hover/data/bm25"
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/hover/code/scorers/hover_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/hover/evals/tmp/variant089-oracle-k15",
  "max_workers": 5
}
