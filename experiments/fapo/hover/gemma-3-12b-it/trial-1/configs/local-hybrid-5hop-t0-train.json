{
  "tenant_id": "hover",
  "provider": "litellm",
  "provider_settings": {
    "model": "bedrock/google.gemma-3-12b-it",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 0.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/hover/datasets/datasets/train.jsonl"
  },
  "chain": {
    "path": "tenants/hover/chains/hybrid.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "extract_entities": "tenants/hover/prompts/modules/extract_entities/variant-001.md",
        "summarize1": "tenants/hover/prompts/modules/summarize1/variant-008.md",
        "query_hop2": "tenants/hover/prompts/modules/query_hop2/variant-006.md",
        "summarize2": "tenants/hover/prompts/modules/summarize2/variant-008.md",
        "query_hop3": "tenants/hover/prompts/modules/query_hop3/variant-006.md",
        "summarize3": "tenants/hover/prompts/modules/summarize3/variant-008.md",
        "query_hop4": "tenants/hover/prompts/modules/query_hop4/variant-006.md",
        "summarize4": "tenants/hover/prompts/modules/summarize4/variant-008.md",
        "query_hop5": "tenants/hover/prompts/modules/query_hop5/variant-006.md"
      },
      "num_hops": 5,
      "retrieval_k": 2000,
      "retrieval_k_later": 3000,
      "entity_k": 1000,
      "llm_passage_limit": 50,
      "bm25_data_dir": "tenants/hover/data/bm25"
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/hover/code/scorers/hover_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/hover/evals/tmp/hybrid-5hop-t0-train",
  "max_workers": 5
}
