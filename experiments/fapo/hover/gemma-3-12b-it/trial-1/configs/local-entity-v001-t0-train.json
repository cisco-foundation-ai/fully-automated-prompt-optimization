{
  "tenant_id": "hover",
  "provider": "litellm",
  "provider_settings": {
    "model": "bedrock/google.gemma-3-12b-it",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 0.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/hover/datasets/datasets/train.jsonl"
  },
  "chain": {
    "path": "tenants/hover/chains/entity_extract.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "extract_entities": "tenants/hover/prompts/modules/extract_entities/variant-001.md"
      },
      "retrieval_k": 2000,
      "entity_k": 1000,
      "bm25_data_dir": "tenants/hover/data/bm25"
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/hover/code/scorers/hover_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/hover/evals/tmp/entity-v001-t0-train",
  "max_workers": 5
}
