{
  "tenant_id": "hover",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-5.4-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/hover/datasets/datasets/test.jsonl"
  },
  "chain": {
    "path": "tenants/hover/chains/multi_hop_4.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "summarize1": "tenants/hover/prompts/modules/summarize1/variant-003.md",
        "query_hop2": "tenants/hover/prompts/modules/query_hop2/variant-003.md",
        "summarize2": "tenants/hover/prompts/modules/summarize2/variant-001.md",
        "query_hop3": "tenants/hover/prompts/modules/query_hop3/variant-003.md",
        "summarize3": "tenants/hover/prompts/modules/summarize3/variant-001.md",
        "query_hop4": "tenants/hover/prompts/modules/query_hop4/variant-001.md"
      },
      "retrieval_k": 200,
      "retrieval_k_hop2": 200,
      "retrieval_k_hop3": 200,
      "retrieval_k_hop4": 200,
      "bm25_data_dir": "tenants/hover/data/bm25"
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/hover/code/scorers/hover_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/hover/evals/tmp/variant051-test",
  "max_workers": 5
}
