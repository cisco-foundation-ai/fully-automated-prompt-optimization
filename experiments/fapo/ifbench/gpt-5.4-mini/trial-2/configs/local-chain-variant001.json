{
  "tenant_id": "ifbench",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-5.4-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 0.5,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/ifbench/datasets/datasets/val.jsonl"
  },
  "chain": {
    "path": "tenants/ifbench/chains/generate_retry.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "generate": "tenants/ifbench/prompts/modules/generate/variant-037-retry3.md",
        "retry": "tenants/ifbench/prompts/modules/generate/variant-047-retry.md",
        "repeat_retry": "tenants/ifbench/prompts/modules/generate/variant-050-repeat-retry.md"
      }
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/ifbench/code/scorers/ifbench_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/ifbench/evals/tmp/optimized-val",
  "max_workers": 5
}
