{
  "tenant_id": "ifbench",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-5.4-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 1.0,
    "top_p": 0.95,
    "max_tokens": 16000
  },
  "dataset": {
    "path": "tenants/ifbench/datasets/datasets/test.jsonl"
  },
  "chain": {
    "path": "tenants/ifbench/chains/generate_verify_verify.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "generate": "tenants/ifbench/prompts/modules/generate/variant-030.md",
        "verify": "tenants/ifbench/prompts/modules/verify/variant-007.md",
        "verify2": "tenants/ifbench/prompts/modules/verify/variant-003b.md"
      }
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/ifbench/code/scorers/ifbench_scorer.py",
      "class_name": "Scorer"
    }
  },
  "output_dir": "tenants/ifbench/evals/tmp/chain-v030v3v3b-test",
  "max_workers": 5
}
