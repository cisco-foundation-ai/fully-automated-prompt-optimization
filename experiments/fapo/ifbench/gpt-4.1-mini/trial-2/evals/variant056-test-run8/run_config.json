{
  "run_id": "hephaestus-ifbench-tflp3i",
  "tenant_id": "ifbench",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-4.1-mini",
    "timeout_seconds": 300,
    "max_retries": 2,
    "retry_backoff_seconds": 5,
    "temperature": 0.0,
    "top_p": 1.0,
    "max_tokens": 16000
  },
  "dataset_path": "tenants/ifbench/datasets/datasets/test.jsonl",
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/ifbench/code/scorers/ifbench_scorer.py",
      "class_name": "Scorer"
    }
  },
  "max_workers": 5,
  "chain": {
    "path": "tenants/ifbench/chains/generate_with_keyword_fix.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "generate": "tenants/ifbench/prompts/modules/generate/variant-037.md"
      }
    }
  }
}