# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/

# Local-only operational artifacts (never checked in)
tenants/*/evals/
tenants/*/configs/**
!tenants/mcp_example/
!tenants/mcp_example/configs/
!tenants/mcp_example/configs/**
!tenants/skill_example/
!tenants/skill_example/configs/
!tenants/skill_example/configs/**
!tenants/*/configs/.gitkeep
!tenants/*/configs/train.json
!tenants/*/configs/eval.json
!tenants/*/configs/test.json
!tenants/hotpotqa/configs/local-chain-variant001.json
!tenants/hotpotqa/configs/remote-chain-variant001.json
!tenants/hotpotqa/configs/local-chain-variant001-train.json
!tenants/hotpotqa/configs/local-chain-variant001-test.json
!tenants/hotpotqa/configs/remote-chain-variant001-train.json
!tenants/hotpotqa/configs/remote-chain-variant001-test.json
tenants/*/reports/**
!tenants/*/reports/.gitkeep
reports/evals/tmp/

# Environment (contains API keys — never commit)
.envrc

# Internal-only docs and scrubbers (contain references to internal infrastructure)
SYNC_GUIDE.md
scripts/check_oss_safety.py

# Local eval results collected from K8s pods
local-results/

# BM25 index and corpus data (large, built on first run)
tenants/hotpotqa/data/
wiki.abstracts.2017.tar.gz

# Customer artifact payloads are GCS-backed, not git-tracked
tenants/*/source_artifacts/*
!tenants/*/source_artifacts/.gitkeep
tenants/*/datasets/*
!tenants/*/datasets/.gitkeep
# Evaluation Asset Studio runtime/checkpoint state is local-only, not git-tracked.
tenants/*/evaluation_assets/**
# Published Studio dataset copies are untracked derived data.
tenants/*/datasets/evaluation_assets/**
.DS_Store
