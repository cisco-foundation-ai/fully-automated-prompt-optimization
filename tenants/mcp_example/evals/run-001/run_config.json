{
  "run_id": "hephaestus-mcp_example-001",
  "tenant_id": "mcp_example",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-4o",
    "temperature": 0.0,
    "max_tokens": 2048
  },
  "dataset_path": "tenants/mcp_example/datasets/tool_tasks.jsonl",
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/mcp_example/code/scorers/task_scorer.py",
      "class_name": "TaskScorer"
    }
  },
  "max_workers": null,
  "chain": {
    "path": "tenants/mcp_example/chains/react_agent.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "agent": "tenants/mcp_example/prompts/modules/agent/variant-001.md"
      }
    }
  }
}