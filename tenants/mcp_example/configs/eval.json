{
  "tenant_id": "mcp_example",
  "provider": "openai",
  "provider_settings": {
    "model": "gpt-4o",
    "temperature": 0.0,
    "max_tokens": 2048
  },
  "mcp": {
    "servers": [
      {
        "name": "mock_tools",
        "command": "python3",
        "args": ["tests/fixtures/mock_mcp_server.py"],
        "env": {},
        "enabled": true,
        "timeout_seconds": 30
      }
    ],
    "tool_execution": {
      "max_iterations": 10,
      "max_tool_calls_per_iteration": 5,
      "timeout_seconds": 10
    }
  },
  "dataset": {
    "path": "tenants/mcp_example/datasets/tool_tasks.jsonl"
  },
  "chain": {
    "path": "tenants/mcp_example/chains/react_agent.py",
    "fn": "build_chain",
    "config": {
      "prompt_paths": {
        "agent": "tenants/mcp_example/prompts/modules/agent/variant-001.md"
      }
    }
  },
  "scoring_profile": {
    "scorer": {
      "module_path": "tenants/mcp_example/code/scorers/task_scorer.py",
      "class_name": "TaskScorer"
    }
  },
  "output_dir": "tenants/mcp_example/evals/run-001",
  "run_id": "hephaestus-mcp_example-001"
}
